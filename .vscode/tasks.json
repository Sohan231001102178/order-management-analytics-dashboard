{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*dev.*$",
          "endsPattern": "^.*Local:.*$"
        }
      },
      "label": "Run OMS Analytics Dashboard (npm run dev)",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
